# ローカル実行用（GitHub Actions では Secrets / Variables に設定）
ANTHROPIC_API_KEY=

# 投稿先（カンマ区切り）: x, threads, bluesky。空なら下書き生成のみ
PUBLISH_PLATFORMS=

# X (旧Twitter) — OAuth 1.0a User Context（Read and Write 権限）
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# Threads — 長期アクセストークン（threads_basic, threads_content_publish）
THREADS_ACCESS_TOKEN=

# Bluesky — ハンドルとアプリパスワード
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=
